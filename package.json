{
  "name": "notes-todo-app",
  "version": "1.0.0",
  "description": "A notes and TODO tracking app with SQLite backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:ui",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:ui": "npx playwright test",
    "test:a11y": "npx playwright test tests/ui/accessibility.spec.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.3",
    "@playwright/test": "^1.52.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.0"
  }
}
